{
  "name": "pshenmic-dpp",
  "version": "2.0.0-dev.1",
  "main": "dist/wasm.js",
  "types": "dist/src/wasm.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/owl352/pshenmic-dpp"
  },
  "scripts": {
    "build:bin": "node build.cjs",
    "build:ts": "tsc && cp -R pkg/**/*.*.node dist/binaries/",
    "build:full": "npm run build:bin && npm run build:ts",
    "ferric:build": "ferric build",
    "bundle": "rollup -c",
    "docs": "tsx old/utils.old/generate-docs.ts && typedoc",
    "tests": "mocha ./tests/*.spec.cjs",
    "lint": "cargo fmt"
  },
  "files": [
    "dist/",
    "tests/"
  ],
  "exports": {
    ".": "./dist/src/wasm.js",
    "./react-native": "./dist/src/react-native.js"
  },
  "author": "owl352",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@scure/base": "^1.2.4",
    "@types/node": "^24.0.13",
    "core-js": "^3.41.0",
    "ferric-cli": "^0.3.9",
    "mocha": "^11.1.0",
    "node-addon-api": "^8.5.0",
    "path": "^0.12.7",
    "toml": "^3.0.0",
    "ts-morph": "^26.0.0",
    "tsx": "^4.20.6",
    "typedoc": "^0.28.7",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@emnapi/core": "^1.7.0",
    "@emnapi/runtime": "^1.7.0",
    "@tybys/wasm-util": "^0.10.1",
    "fflate": "^0.8.2"
  }
}
